# Aliyun SLS Web Tracking API (required)
# Copy to .env and fill in your values.

# SLS project name
ALIYUN_SLS_PROJECT=your_project

# SLS endpoint host, e.g. cn-hangzhou.log.aliyuncs.com
ALIYUN_SLS_HOST=cn-hangzhou.log.aliyuncs.com

# Logstore name for PutWebtracking
ALIYUN_SLS_LOGSTORE=your_logstore

# Log group tag for this collector (e.g. host group name)
ALIYUN_SLS_LOG_GROUP=your_group
